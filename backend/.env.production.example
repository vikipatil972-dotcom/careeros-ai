# CareerOS AI Production Backend Environment Variables Example
PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.railway.internal:5432/railway
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_production_postgres_password
SPRING_REDIS_HOST=redis.railway.internal
SPRING_REDIS_PORT=6379

JWT_SECRET=super_secret_jwt_key_must_be_at_least_256_bits_long_2026

RAZORPAY_KEY_ID=rzp_live_key_id
RAZORPAY_KEY_SECRET=rzp_live_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_live_secret

CASHFREE_APP_ID=cf_live_app_id
CASHFREE_SECRET_KEY=cf_live_secret_key

PHONEPE_MERCHANT_ID=phonepe_merchant_id
PHONEPE_SALT_KEY=phonepe_salt_key

STRIPE_SECRET_KEY=sk_live_stripe_secret
